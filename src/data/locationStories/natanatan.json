  "history": [
    {
      "title": [
        {
          "text": "The Silver Kingdoms",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "60" }]
        }
      ],
      "items": [
        {
          "text": "Natanatan was the last of the Silver Kingdoms to be established, and its Oathgate was the tenth constructed.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "60" }]
        }
      ]
    },
    {
      "title": [
        {
          "text": "History",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "19" },
                { "book": "words-of-radiance", "chapter": "60" },
                { "book": "oathbringer", "chapter": "59" }
              ]
            },
            { "book": "oathbringer", "chapter": "122" }
          ]
        }
      ],
      "items": [
        {
          "text": "Stormseat is thought to have been destroyed in the Last Desolation. Natanatan survived, and after the Recreance joined Thaylenah, Alethkar, Jah Keved and Kharbranth as the five Vorin kingdoms, but it fell several hundred years ago for reasons unknown.",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "19" },
                { "book": "words-of-radiance", "chapter": "60" },
                { "book": "oathbringer", "chapter": "59" }
              ]
            }
          ]
        },
        {
          "text": "Only the city-state of New Natanan remains of the old government. Its people want to reclaim their homeland and its Oathgate.",
          "revealedIn": [{ "book": "oathbringer", "chapter": "122" }]
        }
      ]
    }
  ],
