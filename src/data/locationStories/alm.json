  "history": [
    {
      "title": [
        {
          "text": "The Era of Solitude",
          "revealedIn": [
            { "book": "oathbringer", "chapter": "12" },
            { "book": "dawnshard", "chapter": "9" },
            { "book": "edgedancer", "chapter": "4" }
          ]
        }
      ],
      "items": [
        {
          "text": "Alm joined other Makabaki nations in forming the Azish Empire.",
          "revealedIn": [{ "book": "oathbringer", "chapter": "12" }]
        },
        {
          "text": "Refugees from Aimia settled in Alm at some point after the Recreance; how many came, and when, is unclear.",
          "revealedIn": [{ "book": "dawnshard", "chapter": "9" }]
        },
        {
          "text": "Lift once visited Alm and liked it there, since few people tried to kill her.",
          "revealedIn": [{ "book": "edgedancer", "chapter": "4" }]
        }
      ]
    },
    {
      "title": [
        {
          "text": "The True Desolation",
          "revealedIn": [
            { "book": "edgedancer", "chapter": "14" },
            { "book": "oathbringer", "chapter": "65" }
          ]
        }
      ],
      "items": [
        {
          "text": "Because Alm sits on Roshar's western edge, it and Steen were the earliest nations to send word that the Everstorm had come.",
          "revealedIn": [{ "book": "edgedancer", "chapter": "14" }]
        },
        {
          "text": "Alm had an ambassador in Azimir when Prime Aqasix Yanagawn agreed to visit Urithiru.",
          "revealedIn": [{ "book": "oathbringer", "chapter": "65" }]
        }
      ]
    }
  ],
