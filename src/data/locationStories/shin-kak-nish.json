  "history": [
    {
      "title": [
        {
          "text": "Human arrival",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "i-4" },
                { "book": "oathbringer", "chapter": "115" }
              ]
            }
          ]
        }
      ],
      "items": [
        {
          "text": "When humans arrived on Roshar, Shin Kak Nish was the first land they were given. The Eila Stele records that these newcomers, once taken in by the singers, used Surgebinding against their hosts, who then began to call them Voidbringers.",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "i-4" },
                { "book": "oathbringer", "chapter": "115" }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": [
        {
          "text": "The Heraldic Epochs",
          "revealedIn": [
            {
              "all": [
                { "book": "words-of-radiance", "chapter": "47" },
                { "book": "oathbringer", "chapter": "81" }
              ]
            },
            { "book": "oathbringer", "chapter": "103" }
          ]
        }
      ],
      "items": [
        {
          "text": "Records are sparse, but some Shin were Knights Radiant or fought beside them in the Desolations, such as Naze-daughter-Kuzodo.",
          "revealedIn": [
            {
              "all": [
                { "book": "words-of-radiance", "chapter": "47" },
                { "book": "oathbringer", "chapter": "81" }
              ]
            }
          ]
        },
        {
          "text": "Although nearly impassable mountains surround it, the kingdom still fought with its neighbours. The Shin leader Shubreth-son-Mashalan headed a cavalry campaign called the Shin invasion; his empire is believed to have fallen because it expanded too fast.",
          "revealedIn": [{ "book": "oathbringer", "chapter": "103" }]
        }
      ]
    }
  ],
