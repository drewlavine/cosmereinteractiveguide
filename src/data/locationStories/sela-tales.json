  "history": [
    {
      "title": [
        {
          "text": "History",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "prelude" },
                { "book": "words-of-radiance", "chapter": "i-7" },
                { "book": "rhythm-of-war", "chapter": "1" }
              ]
            },
            { "book": "oathbringer", "chapter": "107" },
            {
              "all": [
                { "book": "way-of-kings", "chapter": "19" },
                { "book": "words-of-radiance", "chapter": "4" }
              ]
            },
            { "book": "way-of-kings", "chapter": "52" }
          ]
        }
      ],
      "items": [
        {
          "text": "Sela Tales was founded in the Silver Kingdoms epoch. Like the other kingdoms, it was knocked back by each Desolation, sometimes to stone tools.",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "prelude" },
                { "book": "words-of-radiance", "chapter": "i-7" },
                { "book": "rhythm-of-war", "chapter": "1" }
              ]
            }
          ]
        },
        {
          "text": "Early in its history, Panatham became its capital, and later held the Selay Oathgate.",
          "revealedIn": [{ "book": "oathbringer", "chapter": "107" }]
        },
        {
          "text": "During the Desolations, the Selay built great fortifications, including a stone fortress on the Purelake.",
          "revealedIn": [
            {
              "all": [
                { "book": "way-of-kings", "chapter": "19" },
                { "book": "words-of-radiance", "chapter": "4" }
              ]
            }
          ]
        },
        {
          "text": "Sometime after Aharietiam, Sela Tales collapsed into several kingdoms, with some regions, like the Purelake, ungoverned. The region kept its name, and after the Recreance the Selay acquired several Shardblades and sets of Shardplate.",
          "revealedIn": [{ "book": "way-of-kings", "chapter": "52" }]
        }
      ]
    }
  ],
  "timeline": [
