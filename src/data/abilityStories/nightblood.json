{
  "intro": [
    {
      "text": "A sentient sword created by Vasher and Shashara through Awakening.",
      "revealedIn": [{ "book": "warbreaker", "chapter": "51" }]
    },
    {
      "text": "Szeth's talking sword, which consumes Investiture when drawn.",
      "revealedIn": [{ "book": "oathbringer", "chapter": "90" }]
    }
  ],
  "description": [
    {
      "text": "It can sense people who have formed a strong bond with it, often through supplying it with Investiture.",
      "revealedIn": [{ "book": "warbreaker", "chapter": "55" }]
    },
    {
      "text": "In Shadesmar, Nightblood and its sheath appear as bright light.",
      "revealedIn": [{ "book": "wind-and-truth", "chapter": "53" }]
    },
    {
      "text": "People aligned with its Intent, or who do not want to use it, can resist its influence.",
      "revealedIn": [{ "book": "wind-and-truth", "chapter": "147" }]
    }
  ],
