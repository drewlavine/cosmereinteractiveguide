      ],
      "items": [
        {
          "text": "The Deepest Ones cannot pass through material that was once alive, including wood.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "56" }]
        },
        {
          "text": "Focused Ones tighten their loose flesh into a compact, resilient body and release that stored tension for powerful movement and attacks.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "61" }]
        },
        {
          "text": "Magnified Ones grow their carapace into tools and weapons without spending Voidlight.",
