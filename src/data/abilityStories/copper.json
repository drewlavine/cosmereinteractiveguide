      "items": [
        {
          "text": "During a mission, Vin felt the Lord Ruler's Soothing reach her despite her coppercloud.",
          "revealedIn": [{ "book": "final-empire", "chapter": "14" }]
        },
        {
          "text": "Vin came to suspect that Inquisitors could see through copperclouds; Kelsier tested the idea and found she was right.",
          "revealedIn": [{ "book": "final-empire", "chapter": "31" }]
        }
      ]
    }
  ],
