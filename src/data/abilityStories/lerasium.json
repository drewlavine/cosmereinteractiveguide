  ],
  "description": [
    {
      "text": "As a Hemalurgic spike, lerasium steals every kind of ability, such as strength, senses or mental sharpness.",
      "revealedIn": [{ "book": "lost-metal", "chapter": "prologue" }]
    },
    {
      "text": "Atium and lerasium can't be joined to make harmonium, and harmonium can't be split into the two by ordinary mechanical means. They can be separated by supernatural means, for instance by reacting harmonium with trellium.",
      "revealedIn": [{ "book": "lost-metal", "chapter": "71" }]
    }
  ],
