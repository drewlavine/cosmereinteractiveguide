{
  "intro": [
    {
      "text": "An alloy of atium and gold, known in legend as the Eleventh Metal. Burning it shows another person as they once were, or as they might have become.",
      "revealedIn": [
        {
          "all": [
            { "book": "final-empire", "chapter": "35" },
            { "book": "hero-of-ages", "chapter": "prologue" }
          ]
        }
      ]
    },
    {
      "text": "An Allomantic metal described on a metal plate the Lord Ruler left in a hidden storage cache. Burning it lets an Allomancer see into another person's past.",
      "revealedIn": [{ "book": "hero-of-ages", "chapter": "5" }]
    }
  ],
  "description": [
    {
      "text": "Malatium is silvery white, much like porcelain. It works as a counterpart to atium, looking into another person's past rather than the future.",
      "revealedIn": [
        {
          "all": [
            { "book": "final-empire", "chapter": "35" },
            { "book": "hero-of-ages", "chapter": "5" }
          ]
        }
      ]
    },
    {
      "text": "Flaring it shows more than a shadow of the person: a glimpse into the Spiritual Realm and a vision of an event from their past, seen through their Connection.",
      "revealedIn": [{ "book": "secret-history", "chapter": "1-1" }]
    }
  ],
  "history": [
    {
      "title": [
        {
          "text": "Kelsier's Eleventh Metal",
          "revealedIn": [
