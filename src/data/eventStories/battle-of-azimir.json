      "items": [
        {
          "text": "The first assault was repelled, but the attackers captured the defenders' Soulcaster.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "42" }]
        },
        {
          "text": "The singers used it to fortify their position in bronze, while Maya left to seek spren reinforcements.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "47" }]
        },
        {
          "text": "Emul and Tashikk's betrayal cut off the expected reinforcements, leaving Azimir to hold alone.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "76" }]
        },
        {
          "text": "A thunderclast killed Neziham; Adolin brought it down but lost his lower right leg, and the defenders lost the dome.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "85" }]
        },
        {
          "text": "The remaining line collapsed, and Yanagawn refused to leave without Adolin as they retreated to a safehouse.",
          "revealedIn": [{ "book": "wind-and-truth", "chapter": "125" }]
        }
