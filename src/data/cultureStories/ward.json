{
  "intro": [
    {
      "text": "A woman who studies under a Vorin scholar as her apprentice.",
      "revealedIn": [{ "book": "way-of-kings", "chapter": "5" }]
    }
  ],
  "description": [
    {
      "text": "A woman scholar may take on students and teach them subjects such as mathematics, logic, art and natural history. She can't be made to accept a ward and may set conditions a candidate must meet first. In return for her education, the ward works as her teacher's scribe and assistant.",
      "revealedIn": [
        {
          "all": [
            { "book": "way-of-kings", "chapter": "28" },
            { "book": "oathbringer", "chapter": "25" }
          ]
        }
      ]
    },
    {
      "text": "Either side may break off a wardship at any time, but it formally ends only when the teacher judges that her student has reached at least the minimum standard of a professional scholar.",
      "revealedIn": [{ "book": "oathbringer", "chapter": "121" }]
    }
  ],
